MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 706356087}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 490c638cde3b1c94195ad429d197c154, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  delay: 0.1
  fullText: "\u0393\u03B5\u03AF\u03B1 \u03C3\u03BF\u03C5 (Hi). \u0398\u03B1 \u03C7\u03C1\u03B5\u03B9\u03B1\u03C3\u03C4\u03CE
    \u03C4\u03B7\u03BD \u03B2\u03BF\u03AE\u03B8\u03B5\u03B9\u03AC \u03C3\u03BF\u03C5
    \u03C3\u03AE\u03BC\u03B5\u03C1\u03B1. \u039A\u03BF\u03AF\u03C4\u03B1\u03BE\u03B5
    (Look at) \u03BC\u03AD\u03C3\u03B1 \u03C3\u03C4\u03B7\u03BD \u03C4\u03AC\u03BE\u03B7(classroom)
    \u03BA\u03B1\u03B9 \u03B2\u03C1\u03AD\u03C2 \u03C4\u03B1 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1
    \u03C0\u03BF\u03C5 \u03BB\u03AD\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD \u03C0\u03AF\u03BD\u03B1\u03BA\u03B1.
    \u038C\u03C3\u03BF \u03C0\u03B9\u03BF \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1
    \u03C4\u03B1 \u03B2\u03C1\u03B5\u03B9\u03C2, \u03C4\u03BF\u03C3\u03BF \u03BC\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03BF
    score \u03B8\u03B1 \u03C0\u03AC\u03C1\u03B5\u03B9\u03C2! \u0391\u03BC\u03B1 \u03B4\u03B5\u03BD
    \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03B9\u03C2 \u03C4\u03BF \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03BF,
    \u03C3\u03B1\u03BD \u03BA\u03B1\u03BB\u03CC\u03C2 \u03BD\u03C4\u03B5\u03BD\u03C4\u03AD\u03BA\u03C4\u03B9\u03B2
    \u03C0\u03BF\u03C5 \u03B5\u03AF\u03C3\u03B1\u03B9 , \u03C0\u03AC\u03C4\u03B1
    \u03C4\u03BF\u03BD \u03BC\u03B5\u03B3\u03B5\u03B8\u03C5\u03BD\u03C4\u03B9\u03BA\u03CC
    \u03C6\u03B1\u03BA\u03CC \u03BA\u03B1\u03B9 \u03B8\u03B1 \u03C3\u03B5 \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03B5\u03B9!!!"
  level: ClassRoom
  imgDot: {fileID: 1428215991}
  imgArrowDot: {fileID: 1912764142}
  imgArrowGlass: {fileID: 113677377}
